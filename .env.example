# Plarno.ai configuration. Copy to .env (never commit .env). All keys are optional: missing keys disable that provider and the app falls back to labelled demo data.
GEMINI_API=                      # language understanding + grounded Q&A (model via GEMINI_MODEL, default gemini-flash-lite-latest)
MAPBOX_API=                      # PUBLIC pk. token: map tiles + directions (the only key sent to the browser)
WEATHER_API=                     # OpenWeather current weather
AQICN_API=                       # air quality (nearest station)
SERP_API=                        # SerpApi (free plan is quota-limited)
SERP_GOOGLE_FLIGHTS_API_KEY=     # defaults to SERP_API; legacy name SERP(GOOGLE FLIGHT)_API is still read
RAPIDAPI_KEY=                    # legacy name RapidAPI is still read. NOT integrated: subscribed hosts unknown
STAYING_API=                     # legacy name Staying_API still read. stay_test_ = SANDBOX fixtures only; stay_live_ = real
QRAIL_API=                       # legacy name Qrail_API still read. NOT integrated: API host/docs unknown

# App settings
PLARNO_SECRET=                   # REQUIRED in production: HMAC key for session tokens
PLARNO_DB=                       # SQLite path for dev (default backend/plarno.db)
PLARNO_ADMIN_EMAILS=             # comma-separated emails that register as admin
PLARNO_CORS=http://localhost:5173
PLARNO_TOKEN_TTL=86400
PLARNO_RATE_LIMIT=300
PLARNO_FLIGHT_SEARCHES_PER_DAY=20   # own guard below SerpApi's monthly quota
PLARNO_OFFLINE=                  # 1 = never call external providers (tests)
OVERPASS_URL=https://overpass-api.de/api/interpreter
GEMINI_MODEL=gemini-flash-lite-latest
PHOTON_URL=https://photon.komoot.io/api/   # as-you-type place search incl. colleges (public server is fair-use; self-host for heavy use)
TELEGRAM_BOT_TOKEN=               # emergency (SOS) alerts are delivered by this bot. Create one with @BotFather
TELEGRAM_CHAT_ID=                 # the chat that receives the alerts (message the bot first, then read your id from @userinfobot)
